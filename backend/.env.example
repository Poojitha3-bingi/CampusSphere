# ----- Server -----
PORT=5000
CLIENT_URL=http://localhost:5173

# ----- MongoDB Atlas -----
# Replace <user>:<password> and cluster info with your own Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/institute_hub?retryWrites=true&w=majority

# ----- Auth -----
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=2d

# ----- Initial admin (created by: npm run seed) -----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@institute.com
ADMIN_PASSWORD=Admin@123
